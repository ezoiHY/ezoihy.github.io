---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="页面未找到" description="你访问的页面不存在。">
	<section class="empty-state shell">
		<div class="code">404</div>
		<h1>这一页还没有被写下。</h1>
		<p>链接可能已经变化，或者内容仍在路上。</p>
		<a class="button primary" href="/">返回首页</a>
	</section>
</BaseLayout>
