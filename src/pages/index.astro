---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { getPublishedPosts } from '../lib/posts';

const posts = (await getPublishedPosts()).slice(0, 4);
---

<BaseLayout title="Ezoihy's Blog">
	<section class="hero">
		<div class="shell hero-grid">
			<div>
				<p class="eyebrow">Personal notes · ideas in progress</p>
				<h1 class="display-title">记录好奇，<br />构建<em>长期</em>有用的东西。</h1>
				<p class="hero-lede">你好，我是 ezoihy。这里收集我的技术笔记、项目实践，以及那些值得反复思考的问题。</p>
				<div class="hero-actions">
					<a class="button primary" href="/posts/">阅读文章 <span aria-hidden="true">→</span></a>
					<a class="button secondary" href="/projects/">看看项目</a>
				</div>
			</div>
			<aside class="signal-card" aria-label="近期关注方向">
				<div class="signal-head"><span>NOW EXPLORING</span><span class="live-dot"></span></div>
				<h2>Web · AI<br />Design</h2>
				<p>把模糊的想法，逐步做成清晰的作品。</p>
				<span class="signal-index">01</span>
			</aside>
		</div>
	</section>

	<section class="section" id="notes">
		<div class="shell">
			<div class="section-heading">
				<div>
					<p class="section-kicker">LATEST NOTES</p>
					<h2 class="section-title">最近写下的内容</h2>
				</div>
				<a class="text-link" href="/posts/">查看全部文章 →</a>
			</div>
			<div class="post-grid">
				{posts.map((post) => <PostCard post={post} />)}
			</div>
		</div>
	</section>

	<section class="section">
		<div class="shell mini-about">
			<p class="lead">在公开记录中，留下成长的坐标。</p>
			<div class="mini-about-copy">
				<p>这个博客是一块长期维护的数字花园。文章不必一次写完，项目也不必一开始就宏大；重要的是持续思考、持续修正、持续留下可以复用的东西。</p>
				<a class="text-link" href="/about/">更多关于我 →</a>
			</div>
		</div>
	</section>
</BaseLayout>
