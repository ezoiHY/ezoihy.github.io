<!doctype html>
<html lang="{{ site.lang | default: 'en' }}" data-background="wallpaper">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% if page.title and page.url != '/' %}{{ page.title | escape }} · {% endif %}{{ site.title | escape }}</title>
    <meta name="description" content="{{ page.description | default: site.description | escape }}">
    <meta name="theme-color" content="#fafbfc">
    <meta name="color-scheme" content="light dark">
    <meta property="og:type" content="{% if page.collection == 'posts' %}article{% else %}website{% endif %}">
    <meta property="og:title" content="{{ page.title | default: site.title | escape }}">
    <meta property="og:description" content="{{ page.description | default: site.description | escape }}">
    <meta property="og:url" content="{{ page.url | absolute_url }}">
    <meta property="og:image" content="{{ '/assets/img/portrait.webp' | absolute_url }}">
    <meta name="twitter:card" content="summary">
    <link rel="canonical" href="{{ page.url | absolute_url }}">
    <link rel="icon" type="image/svg+xml" href="{{ '/assets/img/favicon.svg' | relative_url }}">
    <link rel="alternate" type="application/rss+xml" title="{{ site.title }}" href="{{ '/rss.xml' | relative_url }}">
    <script>try{const r=document.documentElement,t=localStorage.getItem('harry-theme');r.dataset.theme=(t==='light'||t==='dark')?t:(matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light');r.dataset.background=localStorage.getItem('harry-background')==='solid'?'solid':'wallpaper';}catch(e){}</script>
    <script src="{{ '/assets/js/wallpaper.js' | relative_url }}"></script>
    <link rel="stylesheet" href="{{ '/assets/css/studio.css' | relative_url }}">
    <script src="{{ '/assets/js/studio.js' | relative_url }}" defer></script>
    <script src="{{ '/assets/js/liquid-glass.js' | relative_url }}" type="module"></script>
    <script src="{{ '/assets/js/glass-controls.js' | relative_url }}" type="module"></script>
  </head>
  <body data-page="{{ page.page_class | default: 'inner' }}">
    {% include symbols.liquid %}
    <div class="desktop-wallpaper" aria-hidden="true"><div class="wallpaper-layer wallpaper-a"></div><div class="wallpaper-layer wallpaper-b"></div></div>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="header-wrap" data-liquid-glass="navigation">
      <div class="site-header shell">
        <a class="brand" href="{{ '/' | relative_url }}" aria-label="Harry Han home"><strong>Harry</strong> Han</a>
        <nav class="desktop-nav" aria-label="Main navigation">
          {% for item in site.data.navigation %}<a href="{{ item.url | relative_url }}"{% if page.url == item.url or page.nav_section == item.url %} class="active" aria-current="page"{% endif %}>{{ item.title }}</a>{% endfor %}
        </nav>
        <div class="header-tools">
          <button class="icon-button search-trigger" type="button" aria-label="Search site (Command or Control K)" title="Search ⌘K">{% include icon.liquid name='search' %}</button>
          <button class="icon-button background-toggle" type="button" aria-label="Wallpaper and time" aria-haspopup="dialog" aria-controls="wallpaper-dialog" title="Wallpaper and time">{% include icon.liquid name='wallpaper' %}</button>
          <button class="icon-button theme-toggle" type="button" aria-label="Switch to dark mode" title="Change theme"><span class="theme-sun">{% include icon.liquid name='sun' %}</span><span class="theme-moon">{% include icon.liquid name='moon' %}</span></button>
          <button class="icon-button menu-toggle" type="button" aria-label="Open navigation" aria-expanded="false" aria-controls="mobile-nav">{% include icon.liquid name='menu' %}</button>
        </div>
      </div>
      <nav id="mobile-nav" class="mobile-nav shell" aria-label="Mobile navigation" hidden>{% for item in site.data.navigation %}<a href="{{ item.url | relative_url }}"{% if page.url == item.url or page.nav_section == item.url %} aria-current="page"{% endif %}>{{ item.title }}</a>{% endfor %}</nav>
    </header>
    <main id="main" class="main-shell">{% if page.page_class == "home" %}{{ content }}{% else %}<div class="document-panel glass-panel" data-liquid-glass="panel">{{ content }}</div>{% endif %}</main>
    <footer class="site-footer shell" data-liquid-glass="toolbar">
      <p>© {{ 'now' | date: '%Y' }} Harry Han. Powered by <a href="https://jekyllrb.com/" target="_blank" rel="noopener noreferrer">Jekyll</a> & <a href="https://github.com/alshedivat/al-folio" target="_blank" rel="noopener noreferrer">al-folio</a>.</p><a href="{{ '/rss.xml' | relative_url }}">RSS</a>
    </footer>
    <dialog id="wallpaper-dialog" class="wallpaper-dialog" aria-labelledby="wallpaper-title">
      <div class="wallpaper-panel-heading"><div><h2 id="wallpaper-title">Big Sur</h2><p>Wallpaper & time of day</p></div><button class="wallpaper-close icon-button" type="button" aria-label="Close wallpaper settings">{% include icon.liquid name='close' %}</button></div>
      <label class="wallpaper-setting"><span>Show wallpaper</span><input id="wallpaper-enabled" class="toggle-switch" type="checkbox" role="switch" checked></label>
      <fieldset id="wallpaper-time-controls">
        <label class="wallpaper-setting"><span>Follow local time</span><input id="wallpaper-auto" class="toggle-switch" type="checkbox" role="switch" checked></label>
        <div class="wallpaper-time-heading"><label for="wallpaper-time">Preview time</label><input id="wallpaper-time" type="time" value="12:00" aria-label="Wallpaper time"></div>
        <input id="wallpaper-time-slider" class="wallpaper-time-slider" type="range" min="0" max="1439" step="1" value="720" aria-label="Time of day">
        <div class="wallpaper-time-scale" aria-hidden="true"><span>00:00</span><span>06:00</span><span>12:00</span><span>18:00</span><span>24:00</span></div>
        <div class="wallpaper-presets" role="group" aria-label="Time presets"><button type="button" data-wallpaper-preset="06:00">Sunrise</button><button type="button" data-wallpaper-preset="12:00">Day</button><button type="button" data-wallpaper-preset="18:00">Sunset</button><button type="button" data-wallpaper-preset="22:00">Night</button></div>
        <p class="wallpaper-time-hint">Choose a time to preview the changing light.</p>
      </fieldset>
    </dialog>
    <dialog id="search-dialog" class="search-dialog glass" aria-labelledby="search-title">
      <div class="search-top"><label id="search-title" for="site-search">{% include icon.liquid name='search' %}<span class="sr-only">Search site</span></label><input id="site-search" type="search" placeholder="Search projects, pages, and posts…" autocomplete="off"><button class="search-close icon-button" aria-label="Close search" type="button">{% include icon.liquid name='close' %}</button></div>
      <div id="search-results" class="search-results" aria-live="polite"></div>
      <div class="search-bottom"><span>Search projects, pages, and posts</span><span><kbd>esc</kbd> Close</span></div>
    </dialog>
    <script id="search-data" type="application/json">[{% assign search_pages = site.pages | where_exp: 'p', 'p.searchable == true' %}{% assign search_items = search_pages | concat: site.projects | concat: site.posts %}{% for item in search_items %}{"title":{{ item.title | jsonify }},"description":{{ item.description | default: item.excerpt | strip_html | strip_newlines | truncate: 220 | jsonify }},"url":{{ item.url | relative_url | jsonify }},"type":{% if item.collection == 'projects' %}"Project"{% elsif item.collection == 'posts' %}"Post"{% else %}"Page"{% endif %}}{% unless forloop.last %},{% endunless %}{% endfor %}]</script>
  </body>
</html>
