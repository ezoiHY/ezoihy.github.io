<!doctype html>
<html lang="{{ site.lang | default: 'en' }}" data-background="wallpaper">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% if page.title and page.url != '/' %}{{ page.title | escape }} · {% endif %}{{ site.title | escape }}</title>
    <meta name="description" content="{{ page.description | default: site.description | escape }}">
    <meta name="theme-color" content="#fafbfc">
    <meta name="color-scheme" content="light dark">
    <meta property="og:type" content="{% if page.collection == 'posts' %}article{% else %}website{% endif %}">
    <meta property="og:title" content="{{ page.title | default: site.title | escape }}">
    <meta property="og:description" content="{{ page.description | default: site.description | escape }}">
    {% assign canonical_path = page.canonical_url | default: page.url %}
    {% assign share_image = page.social_image | default: page.image | default: site.data.profile.avatar %}
    <meta property="og:url" content="{{ canonical_path | absolute_url }}">
    <meta property="og:image" content="{{ share_image | absolute_url }}">
    <meta property="og:image:alt" content="{{ page.social_image_alt | default: page.image_alt | default: site.data.profile.name | escape }}">
    <meta name="twitter:card" content="{% if page.image or page.social_image %}summary_large_image{% else %}summary{% endif %}">
    <link rel="canonical" href="{{ canonical_path | absolute_url }}">
    <link rel="icon" type="image/svg+xml" href="{{ '/assets/img/favicon.svg' | relative_url }}">
    <link rel="alternate" type="application/atom+xml" title="{{ site.title }}" href="{{ '/rss.xml' | relative_url }}">
    <script>
      (() => {
        const root = document.documentElement;
        root.dataset.wallpaperMotion = 'on';
        try {
          const theme = localStorage.getItem('harry-theme');
          root.dataset.theme = theme === 'light' || theme === 'dark' ? theme : matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          root.dataset.background = localStorage.getItem('harry-background') === 'solid' ? 'solid' : 'wallpaper';
          if (localStorage.getItem('harry-wallpaper-motion') === 'off') root.dataset.wallpaperMotion = 'off';
        } catch { /* Use the page defaults if storage is unavailable. */ }
        // Ambient light takes its phase from the clock, so it continues across pages.
        root.style.setProperty('--ambient-t', (Math.round(Date.now() / 100) % 36000 / 10).toFixed(1));
        // The first page of a visit assembles once; later pages appear directly.
        try {
          if (!sessionStorage.getItem('harry-intro')) { root.dataset.intro = 'play'; sessionStorage.setItem('harry-intro', '1'); }
        } catch { /* Without session storage the page simply appears. */ }
      })();
    </script>
    <script src="{{ '/assets/js/wallpaper.js' | relative_url }}" defer></script>
    <script src="{{ '/assets/js/light.js' | relative_url }}" defer></script>
    <link rel="stylesheet" href="{{ '/assets/css/studio.css' | relative_url }}">
    <link rel="stylesheet" href="{{ '/assets/css/portfolio.css' | relative_url }}">
    <link rel="stylesheet" href="{{ '/assets/css/craft.css' | relative_url }}">
    {% if page.url == '/about/' or page.url == '/cv/' or page.url == '/papers/' or page.url == '/publications/' %}
      <link rel="stylesheet" href="{{ '/assets/css/profile-pages.css' | relative_url }}">
    {% endif %}
    {% if page.url == '/posts/' or page.collection == 'posts' or page.url == '/404.html' %}
      <link rel="stylesheet" href="{{ '/assets/css/writing.css' | relative_url }}">
    {% endif %}
    {% if page.url == '/' or page.url == '/about/' %}
      <link rel="stylesheet" href="{{ '/assets/css/trajectory.css' | relative_url }}">
    {% endif %}
    {% if page.url == '/' %}
      <link rel="stylesheet" href="{{ '/assets/css/home-work.css' | relative_url }}">
      <script src="{{ '/assets/js/home-preview.js' | relative_url }}" defer></script>
    {% endif %}
    {% if page.url == '/' or page.url == '/projects/' or page.layout == 'project' %}
      {% comment %}Match images after the main document has been parsed, before the first paint.{% endcomment %}
      <link rel="expect" href="#site-footer" blocking="render" media="(prefers-reduced-motion: no-preference) and (scripting: enabled)">
      <style>@media (prefers-reduced-motion: no-preference) and (scripting: enabled) { @view-transition { navigation: auto; } }</style>
      <link rel="stylesheet" href="{{ '/assets/css/project-transition.css' | relative_url }}">
      <script src="{{ '/assets/js/project-transition.js' | relative_url }}" data-home="{{ '/' | relative_url }}" data-projects="{{ '/projects/' | relative_url }}" async blocking="render"></script>
    {% endif %}
    {% if page.url == '/projects/' or page.layout == 'project' %}
      <link rel="stylesheet" href="{{ '/assets/css/project-notes.css' | relative_url }}">
    {% endif %}
    {% if page.url == '/projects/' %}
      <script src="{{ '/assets/js/project-compare.js' | relative_url }}" defer></script>
    {% endif %}
    {% if page.url == '/publications/' %}<link rel="stylesheet" href="{{ '/assets/css/research.css' | relative_url }}"><script src="{{ '/assets/js/research-map.js' | relative_url }}" defer></script>{% endif %}
    <noscript><style>.header-tools,.filter-bar,.print-cv,[data-copy],[data-copy-text],.footer-shortcuts,.search-trigger{display:none!important}@media(max-width:760px){.site-header{flex-wrap:wrap}.desktop-nav{display:flex;flex-wrap:wrap;width:100%;order:2}.desktop-nav a{min-height:44px}}</style></noscript>
    <script src="{{ '/assets/js/studio.js' | relative_url }}" defer></script>
    <script src="{{ '/assets/js/project-media.js' | relative_url }}" defer></script>
    <script src="{{ '/assets/js/craft.js' | relative_url }}" defer></script>
    {% if page.url == '/404.html' %}<script src="{{ '/assets/js/reach.js' | relative_url }}" defer></script>{% endif %}
  </head>
  <body id="top" data-page="{{ page.page_class | default: 'inner' }}">
    {% include symbols.liquid %}
    {% if page.layout == 'post' or page.layout == 'project' or page.url == '/about/' or page.url == '/cv/' %}<div class="reading-progress" aria-hidden="true"><span></span></div>{% endif %}
    <div class="desktop-wallpaper" aria-hidden="true">
      <div class="wallpaper-scene"><div class="wallpaper-layer wallpaper-a"></div><div class="wallpaper-layer wallpaper-b"></div></div>
    </div>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="header-wrap">
      <div class="site-header shell">
        <a class="brand" href="{{ '/' | relative_url }}" aria-label="{{ site.title | escape }} home" title="Back to home"><img class="brand-sign" src="{{ '/assets/img/favicon.svg' | relative_url }}" width="30" height="30" alt=""><span><strong>{{ site.first_name | escape }} {{ site.last_name | escape }}</strong> (Harry)</span></a>
        <nav class="desktop-nav" aria-label="Main navigation">
          {% for item in site.data.navigation %}<a href="{{ item.url | relative_url }}"{% if page.url == item.url %} class="active" aria-current="page"{% elsif page.nav_section == item.url %} class="active" aria-current="true"{% endif %}>{{ item.title }}</a>{% endfor %}
        </nav>
        <div class="header-tools">
          <button class="icon-button search-trigger" type="button" aria-label="Search site (Command or Control K)" title="Search ⌘K" aria-haspopup="dialog" aria-controls="search-dialog">{% include icon.liquid name='search' %}</button>
          <button class="icon-button background-toggle" type="button" aria-label="Wallpaper and time" aria-haspopup="dialog" aria-controls="wallpaper-dialog" title="Wallpaper and time">{% include icon.liquid name='wallpaper' %}</button>
          <button class="icon-button theme-toggle" type="button" aria-label="Switch to dark mode" title="Change theme"><span class="theme-sun">{% include icon.liquid name='sun' %}</span><span class="theme-moon">{% include icon.liquid name='moon' %}</span></button>
          <button class="icon-button menu-toggle" type="button" aria-label="Open navigation" aria-expanded="false" aria-controls="mobile-nav">{% include icon.liquid name='menu' %}</button>
        </div>
      </div>
      <nav id="mobile-nav" class="mobile-nav shell" aria-label="Mobile navigation" hidden>{% for item in site.data.navigation %}<a href="{{ item.url | relative_url }}"{% if page.url == item.url %} aria-current="page"{% elsif page.nav_section == item.url %} aria-current="true"{% endif %}>{{ item.title }}</a>{% endfor %}</nav>
    </header>
    <main id="main" class="main-shell">{% if page.page_class == "home" %}{{ content }}{% else %}<div class="document-panel glass-panel">
      {% include coastal-field.liquid %}
      <nav class="breadcrumbs shell" aria-label="Breadcrumb">
        <a class="breadcrumb-home" href="{{ '/' | relative_url }}">{% include icon.liquid name='home' %}<span>Home</span></a>
        <span aria-hidden="true">/</span>
        {% if page.collection == 'projects' %}<a href="{{ '/projects/' | relative_url }}" data-project-return>Projects</a><span aria-hidden="true">/</span>{% elsif page.collection == 'posts' %}<a href="{{ '/posts/' | relative_url }}" data-writing-return>Blog</a><span aria-hidden="true">/</span>{% endif %}
        <span class="breadcrumb-current" aria-current="page" title="{{ page.title | escape }}">{{ page.title | escape }}</span>
      </nav>
      {{ content }}</div>{% endif %}</main>
    <footer class="site-footer shell" id="site-footer">
      <div class="footer-main">
        <div class="footer-identity">
          <p class="footer-name">{{ site.first_name | escape }} {{ site.last_name | escape }} <span>(Harry)</span></p>
          <p>Robotics Engineering, SCUT · PAIRS Lab, HKUST(GZ)</p>
          <p class="footer-clock" data-local-clock data-timezone="{{ site.timezone }}" hidden><span>{{ site.data.profile.location | split: ',' | first | escape }}</span><time>--:--</time><span data-clock-offset></span></p>
        </div>
        <nav class="footer-column footer-sitemap" aria-label="Site sections">
          <p class="footer-heading">Site</p>
          {% for item in site.data.navigation %}<a href="{{ item.url | relative_url }}"{% if page.url == item.url %} aria-current="page"{% endif %}>{{ item.title }}</a>{% endfor %}
        </nav>
        <nav class="footer-column" aria-label="Elsewhere">
          <p class="footer-heading">Elsewhere</p>
          <a href="mailto:{{ site.data.profile.email | escape }}">Email</a>
          <a href="{{ site.data.profile.github | escape }}" target="_blank" rel="noopener noreferrer">GitHub {% include icon.liquid name='external' %}</a>
          <a href="{{ '/rss.xml' | relative_url }}">RSS</a>
          <a href="{{ '/assets/pdf/yu-han-cv.pdf' | relative_url }}" download>CV (PDF)</a>
        </nav>
      </div>
      <div class="footer-base">
        <p>© {{ 'now' | date: '%Y' }} {{ site.author | escape }}. Powered by <a href="https://jekyllrb.com/" target="_blank" rel="noopener noreferrer">Jekyll</a> & <a href="https://github.com/alshedivat/al-folio" target="_blank" rel="noopener noreferrer">al-folio</a>. Updated <time datetime="{{ site.time | date_to_xmlschema }}">{{ site.time | date: '%b %-d, %Y' }}</time>.</p>
        <nav class="footer-links" aria-label="Footer navigation">{% if page.url != '/' %}<a href="{{ '/' | relative_url }}">Back to home</a>{% endif %}<a class="back-to-top" href="#top">Back to top {% include icon.liquid name='arrow' %}</a><button class="footer-shortcuts" type="button" data-shortcuts-open hidden><kbd>?</kbd> Shortcuts</button></nav>
      </div>
    </footer>
    <dialog id="wallpaper-dialog" class="wallpaper-dialog" aria-labelledby="wallpaper-title">
      <div class="wallpaper-panel-heading"><div><h2 id="wallpaper-title">Big Sur</h2><p>Wallpaper & time of day</p></div><button class="wallpaper-close icon-button" type="button" aria-label="Close wallpaper settings">{% include icon.liquid name='close' %}</button></div>
      <label class="wallpaper-setting"><span>Show wallpaper</span><input id="wallpaper-enabled" class="toggle-switch" type="checkbox" role="switch"></label>
      <label class="wallpaper-setting"><span>Animate light</span><input id="wallpaper-motion" class="toggle-switch" type="checkbox" role="switch" checked aria-describedby="wallpaper-motion-hint"></label>
      <p id="wallpaper-motion-hint" class="wallpaper-time-hint" hidden></p>
      <fieldset id="wallpaper-time-controls">
        <label class="wallpaper-setting"><span>Follow local time</span><input id="wallpaper-auto" class="toggle-switch" type="checkbox" role="switch" checked></label>
        <div class="wallpaper-time-heading"><label for="wallpaper-time">Preview time</label><input id="wallpaper-time" type="time" value="12:00" aria-label="Wallpaper time"></div>
        <input id="wallpaper-time-slider" class="wallpaper-time-slider" type="range" min="0" max="1439" step="1" value="720" aria-label="Time of day">
        <div class="wallpaper-time-scale" aria-hidden="true"><span>00:00</span><span>06:00</span><span>12:00</span><span>18:00</span><span>24:00</span></div>
        <div class="wallpaper-presets" role="group" aria-label="Time presets"><button type="button" data-wallpaper-preset="06:00">Sunrise</button><button type="button" data-wallpaper-preset="12:00">Day</button><button type="button" data-wallpaper-preset="18:00">Sunset</button><button type="button" data-wallpaper-preset="22:00">Night</button></div>
        <p class="wallpaper-time-hint">Choose a time to preview the changing light.</p>
      </fieldset>
    </dialog>
    <dialog id="search-dialog" class="search-dialog glass" aria-labelledby="search-title" data-email="{{ site.data.profile.email | escape }}" data-github="{{ site.data.profile.github | escape }}" data-cv="{{ '/assets/pdf/yu-han-cv.pdf' | relative_url }}" data-rss="{{ '/rss.xml' | relative_url }}">
      <div class="search-top"><label id="search-title" for="site-search">{% include icon.liquid name='search' %}<span class="sr-only">Search site</span></label><input id="site-search" type="search" placeholder="Search or type a command…" maxlength="200" autocomplete="off"><button class="search-close icon-button" aria-label="Close search" type="button">{% include icon.liquid name='close' %}</button></div>
      <div class="search-scopes" role="group" aria-label="Search within">
        <button type="button" data-search-type="all" aria-pressed="true">All</button>
        <button type="button" data-search-type="Project" aria-pressed="false">Projects</button>
        <button type="button" data-search-type="Research" aria-pressed="false">Research</button>
        <button type="button" data-search-type="Post" aria-pressed="false">Posts</button>
        <button type="button" data-search-type="Page" aria-pressed="false">Pages</button>
      </div>
      <div id="search-results" class="search-results"></div>
      <div class="search-bottom"><span id="search-summary" role="status">Search projects, pages, and posts</span><span class="search-keys"><kbd>↑</kbd><kbd>↓</kbd> Move <kbd>↵</kbd> Open <kbd>esc</kbd> Close</span></div>
    </dialog>
    <dialog id="shortcuts-dialog" class="shortcuts-dialog" aria-labelledby="shortcuts-title">
      <div class="shortcuts-heading"><h2 id="shortcuts-title">Keyboard shortcuts</h2><button class="icon-button" type="button" data-shortcuts-close aria-label="Close keyboard shortcuts">{% include icon.liquid name='close' %}</button></div>
      <dl class="shortcuts-list">
        <div><dt><kbd>⌘</kbd><kbd>K</kbd> or <kbd>/</kbd></dt><dd>Search and commands</dd></div>
        {% for item in site.data.navigation %}<div><dt><kbd>G</kbd> then <kbd>{{ item.title | slice: 0 | upcase }}</kbd></dt><dd>Go to {{ item.title }}</dd></div>{% endfor %}
        <div><dt><kbd>T</kbd></dt><dd>Switch light or dark theme</dd></div>
        <div><dt><kbd>?</kbd></dt><dd>Show this list</dd></div>
        <div><dt><kbd>Esc</kbd></dt><dd>Close a dialog</dd></div>
      </dl>
      <p class="shortcuts-note">Shortcuts pause while you type in a field.</p>
    </dialog>
    <div class="toast" data-toast popover="manual" aria-hidden="true" hidden></div>
    <p class="sr-only" data-toast-status role="status" aria-live="polite"></p>
    <script id="search-data" type="application/json">{% include search-data.liquid %}</script>
  </body>
</html>
