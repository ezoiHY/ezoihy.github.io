---
layout: default
nav_section: /projects/
---
<article class="project-detail shell">
  <header class="page-heading detail-heading">
    <a class="back-link" href="{{ '/projects/' | relative_url }}">← Projects</a>
    <h1>{{ page.title }}</h1>
    <p>{{ page.description }}</p>
    <p class="entry-meta">{{ page.year }} · {{ page.category }}</p>
    {% if page.tags.size > 0 %}<p class="project-tags">{{ page.tags | join: ' · ' }}</p>{% endif %}
  </header>
  {% if page.image %}
    <figure class="project-figure">
      {% if page.video %}
        {% include project-media.liquid project=page loading='eager' %}
      {% else %}
        <img src="{{ page.image | relative_url }}" alt="{{ page.image_alt | default: page.title | escape }}" width="{{ page.image_width | default: 800 }}" height="{{ page.image_height | default: 560 }}">
      {% endif %}
      <figcaption>{{ page.image_caption | default: 'Conceptual illustration, not a photograph of the project hardware' }}{% if page.video_source %} <a href="{{ page.video_source | escape }}" target="_blank" rel="noopener noreferrer">Watch the full demo on Bilibili</a>.{% elsif page.image_source %} <a href="{{ page.image_source | escape }}" target="_blank" rel="noopener noreferrer">View the original screenshot</a>.{% endif %}</figcaption>
    </figure>
  {% endif %}
  <div class="prose page-content">{{ content }}</div>
</article>
