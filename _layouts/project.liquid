---
layout: default
nav_section: /projects/
---
<link rel="stylesheet" href="{{ '/assets/css/project-viewer.css' | relative_url }}">
<script src="{{ '/assets/js/project-viewer.js' | relative_url }}" defer></script>
<article class="project-detail shell">
  <header class="page-heading detail-heading">
    <h1>{{ page.title }}</h1>
    <p>{{ page.description }}</p>
    <p class="entry-meta">{{ page.year }} · {{ page.category }}</p>
    {% if page.tags.size > 0 %}<p class="project-tags">{{ page.tags | join: ' · ' }}</p>{% endif %}
    {% if page.code_url or page.video_source %}
      <nav class="profile-links" aria-label="Project resources">
        {% if page.code_url %}<a class="button" href="{{ page.code_url | escape }}" target="_blank" rel="noopener noreferrer">View code</a>{% endif %}
        {% if page.video_source %}<a class="button" href="{{ page.video_source | escape }}" target="_blank" rel="noopener noreferrer">Watch full demo</a>{% endif %}
      </nav>
    {% endif %}
  </header>
  {% if page.image %}
    <figure class="project-figure{% if page.wide_media %} project-figure-wide{% endif %}">
      {% if page.video %}
        {% include project-media.liquid project=page loading='eager' %}
      {% else %}
        <a class="project-media-link" href="{{ page.image | relative_url }}" data-project-viewer aria-label="Enlarge project image"><img src="{{ page.image | relative_url }}" alt="{{ page.image_alt | default: page.title | escape }}" width="{{ page.image_width | default: 800 }}" height="{{ page.image_height | default: 560 }}"></a>
      {% endif %}
      <figcaption>{{ page.image_caption | default: 'Conceptual illustration, not a photograph of the project hardware' }}{% if page.video_source %} <a href="{{ page.video_source | escape }}" target="_blank" rel="noopener noreferrer">Watch the full demo on Bilibili</a>.{% elsif page.image_source %} <a href="{{ page.image_source | escape }}" target="_blank" rel="noopener noreferrer">View the original screenshot</a>.{% endif %}</figcaption>
    </figure>
  {% endif %}
  <div class="prose page-content">{{ content }}</div>
  <footer class="project-continuation">
    <nav class="project-return-links" aria-label="Project navigation">
      <a href="{{ '/projects/' | relative_url }}" data-project-return>All projects</a>
      {% if site.data.profile.email %}<a href="mailto:{{ site.data.profile.email | escape }}">Email</a>{% endif %}
    </nav>
    {% if page.category == 'Software' %}
      {% assign continuation_projects = site.projects | where: 'category', 'Software' %}
      {% assign continuation_heading = 'More research software' %}
    {% else %}
      {% assign continuation_projects = site.projects | where_exp: 'project', "project.category != 'Software'" %}
      {% assign continuation_heading = 'More robotics projects' %}
    {% endif %}
    {% if continuation_projects.size > 1 %}
      <nav class="project-more" aria-labelledby="project-more-title">
        <h2 id="project-more-title">{{ continuation_heading }}</h2>
        <ul>
          {% assign continuation_count = 0 %}
          {% assign continuation_years = continuation_projects | group_by: 'sort_year' | sort: 'name' | reverse %}
          {% for project_year in continuation_years %}
            {% assign year_projects = project_year.items | sort: 'sort_priority' | reverse %}
            {% for project in year_projects %}
              {% if project.url != page.url and continuation_count < 2 %}
                <li><a href="{{ project.url | relative_url }}" data-project-continue>{{ project.title }}</a><span>{{ project.year }} · {{ project.category }}</span></li>
                {% assign continuation_count = continuation_count | plus: 1 %}
              {% endif %}
            {% endfor %}
          {% endfor %}
        </ul>
      </nav>
    {% endif %}
  </footer>
</article>
<dialog id="project-viewer" class="project-viewer" aria-label="Project image viewer">
  <div class="project-viewer-toolbar">
    <p class="project-viewer-count" aria-live="polite" aria-atomic="true"></p>
    <div class="project-viewer-actions">
      <button type="button" data-viewer-size aria-pressed="false">Actual size</button>
      <a data-viewer-original target="_blank" rel="noopener noreferrer">Open original</a>
      <button type="button" data-viewer-close autofocus>Close</button>
    </div>
  </div>
  <div class="project-viewer-stage">
    <button class="project-viewer-switch" type="button" data-viewer-previous aria-label="Previous image">←</button>
    <div class="project-viewer-viewport" tabindex="0" aria-label="Image; scroll to inspect at actual size">
      <img class="project-viewer-image" alt="">
      <p class="project-viewer-status" role="status"></p>
    </div>
    <button class="project-viewer-switch" type="button" data-viewer-next aria-label="Next image">→</button>
  </div>
  <div class="project-viewer-caption"></div>
</dialog>
