---
layout: default
nav_section: /posts/
---
<article class="post-detail shell">
  <header class="page-heading detail-heading">
    <h1>{{ page.title | escape }}</h1>
    <p class="entry-meta">
      <time datetime="{{ page.date | date_to_xmlschema }}">{{ page.date | date: '%Y.%m.%d' }}</time> ·
      <a href="{{ '/about/' | relative_url }}">{{ site.data.profile.name | escape }}</a>
      {% for category in page.categories %}
        {% if forloop.first %} · {% else %} / {% endif %}
        <a data-post-category="{{ category | escape }}" href="{{ '/posts/' | relative_url }}?category={{ category | url_encode }}" aria-label="Browse {{ category | escape }} posts">{{ category | escape }}</a>
      {% endfor %}
    </p>
    {% if page.description %}<p>{{ page.description | escape }}</p>{% endif %}
    {% if page.tags.size > 0 %}<p class="entry-meta post-tags"><span class="sr-only">Topics: </span>{{ page.tags | join: ' · ' | escape }}</p>{% endif %}
  </header>
  <div class="post-reading">
    <details class="reading-index" hidden>
      <summary>In this article</summary>
      <nav data-reading-index aria-label="Article sections"><ul></ul></nav>
    </details>
    <div class="prose post-prose page-content reading-prose">{{ content }}</div>
  </div>
  <nav class="article-end" aria-label="Post navigation">
    <a data-writing-return class="reading-archive-link" href="{{ '/posts/' | relative_url }}"><span data-return-label>All posts</span></a>
    {% if page.previous %}
      <a class="reading-neighbor" href="{{ page.previous.url | relative_url }}"><small>Previous post</small>{{ page.previous.title | escape }}</a>
    {% endif %}
    {% if page.next %}
      <a class="reading-neighbor" href="{{ page.next.url | relative_url }}"><small>Next post</small>{{ page.next.title | escape }}</a>
    {% endif %}
  </nav>
</article>
<script src="{{ '/assets/js/article-index.js' | relative_url }}" defer></script>
