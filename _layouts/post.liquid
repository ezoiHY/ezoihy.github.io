---
layout: default
nav_section: /posts/
---
<article class="post-detail shell">
  <header class="page-heading detail-heading">
    <a class="back-link" href="{{ '/posts/' | relative_url }}">← Blog</a>
    <h1>{{ page.title }}</h1>
    <p class="entry-meta"><time datetime="{{ page.date | date_to_xmlschema }}">{{ page.date | date: '%Y.%m.%d' }}</time> · {{ site.data.profile.name }}{% if page.categories.size > 0 %} · {{ page.categories | join: ' / ' }}{% endif %}</p>
    {% if page.description %}<p>{{ page.description }}</p>{% endif %}
    {% if page.tags.size > 0 %}<p class="post-tags">{{ page.tags | join: ' · ' }}</p>{% endif %}
  </header>
  <div class="prose post-prose page-content">{{ content }}</div>
</article>
