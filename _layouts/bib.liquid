<article class="publication-entry" id="{{ entry.key }}">
  <div class="publication-year">{{ entry.year }}</div><div><h3>{{ entry.title }}</h3><p class="publication-authors">{{ entry.author }}</p><p class="publication-venue">{{ entry.journal | default: entry.booktitle }}{% if entry.volume %}, {{ entry.volume }}{% endif %}</p><div class="publication-links">{% if entry.doi %}<a href="https://doi.org/{{ entry.doi }}" target="_blank" rel="noopener noreferrer">DOI ↗</a>{% endif %}{% if entry.pdf %}<a href="{{ entry.pdf | relative_url }}" target="_blank" rel="noopener noreferrer">PDF ↗</a>{% endif %}{% if entry.code %}<a href="{{ entry.code }}" target="_blank" rel="noopener noreferrer">Code ↗</a>{% endif %}{% if entry.abstract %}<details><summary>Abstract</summary><p>{{ entry.abstract }}</p></details>{% endif %}<details><summary>BibTeX</summary><pre>{{ entry.bibtex | escape }}</pre></details></div></div>
</article>
