{%- comment -%}
  Research interests around a sense–learn–act core. Every card stays readable without
  JavaScript; research-map.js adds the connections, selection and shared-evidence chords.
  data-map-evidence lists the local pages a topic links to, so topics citing the same work
  can be connected.
{%- endcomment -%}
<div class="research-map" data-research-map>
  <svg class="research-map-lines" aria-hidden="true" focusable="false"></svg>
  <button class="research-map-hub" type="button" data-map-hub aria-label="Robotics: show topic overview" disabled>
    <span class="hub-dial" aria-hidden="true">
      <span class="hub-track"></span>
      <span class="hub-orbit"><span class="hub-sweep"></span><span class="hub-head"></span></span>
      <span class="hub-station" style="--i:0"></span><span class="hub-station" style="--i:1"></span><span class="hub-station" style="--i:2"></span>
    </span>
    <span class="research-map-hub-title">Robotics</span>
    <span class="research-map-hub-detail"><span style="--i:0">Perception</span><span style="--i:1">Learning</span><span style="--i:2">Action</span></span>
  </button>
  {% for interest in site.data.profile.research_interests %}
    {% assign interest_id = interest.title | slugify %}
    {% case interest_id %}
      {% when 'dexterous-manipulation' %}{% assign interest_icon = 'gripper' %}
      {% when 'multimodal-sensing' %}{% assign interest_icon = 'modalities' %}
      {% when 'force-aware-robot-learning' %}{% assign interest_icon = 'force' %}
      {% when 'human-sensing' %}{% assign interest_icon = 'human-sensing' %}
      {% when 'embodied-intelligence' %}{% assign interest_icon = 'embodied' %}
      {% else %}{% assign interest_icon = 'research' %}
    {% endcase %}
    {% capture evidence %}{% for link in interest.links %}{{ link.url | relative_url }} {% endfor %}{% if interest.context_link %}{{ interest.context_link.url | relative_url }}{% endif %}{% endcapture %}
    <article class="research-map-node" data-map-node="{{ interest_id }}" data-map-position="{{ forloop.index }}" data-map-evidence="{{ evidence | strip }}" data-spotlight aria-labelledby="interest-{{ interest_id }}">
      <span class="map-port" aria-hidden="true"></span>
      <div class="map-node-head">
        <span class="map-node-icon" aria-hidden="true">{% include icon.liquid name=interest_icon %}</span>
        <p class="map-node-index" aria-hidden="true">{% if forloop.index < 10 %}0{% endif %}{{ forloop.index }}</p>
        <h3 id="interest-{{ interest_id }}"><button class="research-map-select" type="button" data-map-select="{{ interest_id }}" aria-expanded="true" aria-controls="context-{{ interest_id }}" disabled>{{ interest.title }}</button></h3>
      </div>
      <p class="map-node-description">{{ interest.description }}</p>
      {% if interest.links %}<div class="research-map-links">{% for link in interest.links %}<a href="{{ link.url | relative_url }}">{{ link.title }}</a>{% endfor %}</div>{% endif %}
      <div class="research-map-context" id="context-{{ interest_id }}">
        {% if interest.context %}<p>{{ interest.context }}</p>{% endif %}
        {% if interest.context_link %}<a href="{{ interest.context_link.url | relative_url }}">{{ interest.context_link.title }}</a>{% endif %}
        <a class="topic-permalink" href="#interest-{{ interest_id }}" aria-label="Permalink to {{ interest.title }}">Link to topic</a>
      </div>
    </article>
  {% endfor %}
</div>
