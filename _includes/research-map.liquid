<div class="research-map" data-research-map>
  <svg class="research-map-lines" aria-hidden="true" focusable="false"></svg>
  <button class="research-map-hub" type="button" data-map-hub aria-label="Robotics: clear selection" title="Clear selection" disabled>
    <span class="research-map-hub-title">Robotics</span>
    <span class="research-map-hub-detail"><span>Perception</span><span>Learning</span><span>Action</span></span>
  </button>
  {% for interest in site.data.profile.research_interests %}
    {% assign interest_id = interest.title | slugify %}
    <article class="research-map-node" data-map-node="{{ interest_id }}" data-map-position="{{ forloop.index }}" aria-labelledby="interest-{{ interest_id }}">
      <h3 id="interest-{{ interest_id }}"><button class="research-map-select" type="button" data-map-select="{{ interest_id }}" aria-pressed="false" disabled>{{ interest.title }}</button></h3>
      <p>{{ interest.description }}</p>
      {% if interest.links %}<div class="research-map-links">{% for link in interest.links %}<a href="{{ link.url | relative_url }}">{{ link.title }}</a>{% endfor %}</div>{% endif %}
    </article>
  {% endfor %}
</div>
